# BTG Project Monitor — Railway / production template
# Copy to .env and fill real values. Never commit secrets.

BTG_EMAIL=your-btg-email@example.com
BTG_PASSWORD=your-btg-password

MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/?retryWrites=true&w=majority

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-sender@example.com
SENDER_PASSWORD=your-app-password

RECIPIENT_EMAILS=project1@example.com,project2@example.com
error_recipent=operations@example.com
ERROR_EMAIL_COOLDOWN_MINUTES=30

HEADLESS=true
CHECK_INTERVAL=300
LOGIN_RETRY_INTERVAL=1800
MAX_AGE_MINUTES=60

BTG_PREFLIGHT_ENABLED=true
BTG_PREFLIGHT_URL=https://api.businesstalentgroup.com/auth/sign_in
BTG_PREFLIGHT_TIMEOUT=30
BTG_PREFLIGHT_FAILURE_RETRY_SECONDS=1800

CHROME_BIN=/usr/bin/chromium
CHROMEDRIVER_PATH=/usr/bin/chromedriver

TZ=Asia/Karachi
EVIDENCE_DIR=/tmp/btg-evidence
EVIDENCE_RETENTION_HOURS=24
COOKIE_FILE=/tmp/btg_cookies.json

# Local diagnostics only — keep false in Railway
BTG_LOGIN_DIAGNOSTIC_MODE=false
BTG_CLEAR_SESSION_ON_START=false
BTG_CAPTURE_NETWORK_LOGS=false
BTG_PAUSE_AFTER_LOGIN_FAILURE=false

# Worker lock / single-replica coordination
BTG_WORKER_LOCK_ENABLED=true
BTG_WORKER_LOCK_TTL_SECONDS=180

# PORT is provided automatically by Railway
# PORT=8080
